+int NodeService::setExternalMulticastGroup(uint64_t net_id, uint64_t mac, uint32_t adi, bool subscribed)
+{
+    if (! net_id || (mac & 0x010000000000ULL) == 0 || (mac & 0xffff000000000000ULL) != 0) {
+        return ZTS_ERR_ARG;
+    }
+    Mutex::Lock _l(_nets_m);
+    std::map<uint64_t, NetworkState>::iterator n(_nets.find(net_id));
+    if (n == _nets.end() || ! n->second.tap) return ZTS_ERR_NO_RESULT;
+    n->second.tap->setExternalMulticastGroup(MAC(mac), adi, subscribed);
+    return ZTS_ERR_OK;
+}
+
+int NodeService::clearExternalMulticastGroups(uint64_t net_id)
+{
+    if (! net_id) return ZTS_ERR_ARG;
+    Mutex::Lock _l(_nets_m);
+    std::map<uint64_t, NetworkState>::iterator n(_nets.find(net_id));
+    if (n == _nets.end() || ! n->second.tap) return ZTS_ERR_NO_RESULT;
+    n->second.tap->clearExternalMulticastGroups();
+    return ZTS_ERR_OK;
+}
