+int NodeService::getLoadedPlanet(void* data, unsigned int* len)
+{
+    Mutex::Lock lock(_store_m);
+    if (_loadedPlanet.empty()) return ZTS_ERR_SERVICE;
+    if (!data || !len || *len < _loadedPlanet.size()) return ZTS_ERR_ARG;
+    memcpy(data, _loadedPlanet.data(), _loadedPlanet.size());
+    *len = static_cast<unsigned int>(_loadedPlanet.size());
+    return ZTS_ERR_OK;
+}
