+bool VirtualTap::setExternalMulticastGroup(const MAC& mac, uint32_t adi, bool subscribed)
+{
+    Mutex::Lock _l(_multicastGroups_m);
+    const MulticastGroup group(mac, adi);
+    std::vector<MulticastGroup>::iterator existing =
+        std::find(_externalMulticastGroups.begin(), _externalMulticastGroups.end(), group);
+    if (subscribed) {
+        if (existing != _externalMulticastGroups.end()) return false;
+        _externalMulticastGroups.push_back(group);
+        std::sort(_externalMulticastGroups.begin(), _externalMulticastGroups.end());
+        return true;
+    }
+    if (existing == _externalMulticastGroups.end()) return false;
+    _externalMulticastGroups.erase(existing);
+    return true;
+}
+
+void VirtualTap::clearExternalMulticastGroups()
+{
+    Mutex::Lock _l(_multicastGroups_m);
+    _externalMulticastGroups.clear();
+}
