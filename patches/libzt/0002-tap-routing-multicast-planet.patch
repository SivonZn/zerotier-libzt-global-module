+int zts_net_send_frame(uint64_t net_id, const void* frame, unsigned int len)
+{
+    ACQUIRE_SERVICE(ZTS_ERR_SERVICE);
+    if (! frame || len < 14) {
+        return ZTS_ERR_ARG;
+    }
+    const auto* bytes = reinterpret_cast<const uint8_t*>(frame);
+    uint64_t source = 0;
+    uint64_t dest = 0;
+    for (unsigned int i = 0; i < 6; ++i) {
+        dest = (dest << 8) | bytes[i];
+        source = (source << 8) | bytes[6 + i];
+    }
+    const unsigned int etherType = (static_cast<unsigned int>(bytes[12]) << 8) | bytes[13];
+    // Frames read from the kernel TAP are outbound from this node. Feed them
+    // through the VirtualTap transmit handler into ZeroTier Core.
+    zts_service->tapFrameHandler(
+        net_id, MAC(source), MAC(dest), etherType, 0, bytes + 14, len - 14);
+    return ZTS_ERR_OK;
+}
+
